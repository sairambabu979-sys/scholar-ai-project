# Scholar AI environment template.
# Copy to .env.local (git-ignored) and fill in values. Never commit real secrets.
# Startup validation (packages/config) refuses unsafe production configurations.

NODE_ENV=development
APP_URL=http://localhost:3000

# Local development database only. Production must use a distinct, least-privileged credential.
DATABASE_URL=postgresql://scholar:local-development-only@localhost:5432/scholar
# Integration/e2e tests refuse any database whose name does not end in "_test".
TEST_DATABASE_URL=postgresql://scholar:local-development-only@localhost:5432/scholar_test

# Session signing secret. Required (>= 32 chars) in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Comma-separated emails allowed to create an account. Required in production.
AUTH_ALLOWED_EMAILS=

# Google identity (sign-in) and Google Tasks (separate permission grant, Phase 2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
GOOGLE_TASKS_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback

# Canvas LMS (Phase 3). Requires an institution-approved developer key.
CANVAS_ENABLED=false
CANVAS_BASE_URL=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=http://localhost:3000/api/v1/integrations/canvas/callback

# Token envelope encryption (Phase 2). Production uses a managed key store instead.
TOKEN_KEY_ID=local-v1
TOKEN_ENCRYPTION_KEY_BASE64=

# AI provider (Phase 4). A Claude Code subscription is not an API credential.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT_USD=2.00

SYNC_INTERVAL_SECONDS=900

# mock = synthetic fixtures, no provider calls. live = real providers. Production requires live.
INTEGRATIONS_MODE=mock
# Must stay false until the M5 completion gate passes. A global switch never bypasses per-action approval.
EXTERNAL_WRITES_ENABLED=false

# Mock mode only: password for the seeded synthetic demo accounts. Ignored (and sign-in
# with it disabled) in live mode. Leave empty to use the documented local default.
DEMO_PASSWORD=
